# Merge all data. You can choose to select only one year, month, etc. 
usagedata<-rbind(usagedata2019,usagedata2020,usagedata2021,usagedata2022,usagedata2023,usagedata2023a,usagedata2024a,usagedata2024b,usagedata2024c,usagedata2024d,usagedata2025a,usagedata2025b,usagedata2025c,usagedata2025d,usagedata2025e,usagedata2026a,usagedata2026b,usagedata2026c)

#### Some sanity checks. Are all systems in there, what does data look like, etc. 
levels(as.factor(usagedata$System))

usagedata[c(1:200),]
usagedata[24,]

###Filter irrelevant data, eg. analysis workstations, cancelled sessions, training sessions, etc. 
usagedata_nocanc<-usagedata %>%
  filter(Notes!="cancelled" | is.na(Notes) )

usagedata_nocanc_notrain<-usagedata_nocanc %>%
  filter(SE2.comments!="Training" | is.na(Notes) )
usagedata_nocanc_notrain<-usagedata_nocanc_notrain %>%
  filter(SE2.comments!="Training session" | is.na(Notes) )
#usagedata_nocanc_notrain<-usagedata_nocanc_notrain %>%
#    filter(Group!="FCF"  )
usagedata_nocanc_notrain<-usagedata_nocanc_notrain %>% # Filters instruments wich are free to use and not taken into consideration
  filter(System!="Analysis 1"& System!="Analysis 2" & System!="Analysis 3" & System!="FCS Express - License 1" & System!="Workstation 1"& System!="Workstation 2" & System!="Cytek Cloud Pro License"  )
usagedata_nocanc_notrain2<-usagedata_nocanc_notrain %>%
  filter(Amount!=0 | is.na(Notes) ) # Sometimes, during an incident, operators keep session in PPMS, but change cost to 0. 


### Make data format readable for R
dates2<-gsub("/","-",usagedata_nocanc_notrain$Date)
head(dates2)
usagedata_nocanc_notrain$Date<-dates2

### Make wide & long data tables with use per day
usagedataperday_wide<-dcast(as.data.table(usagedata_nocanc_notrain),Date ~ System , value.var="Length.booked", fun.aggregate = sum)
usagedataperday_long<-melt(usagedataperday_wide, id.vars="Date")
head(usagedataperday_wide)


